NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://priyo:priyo@localhost:5432/priyo_host
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_MAX_BYTES=104857600
DEPLOYMENT_TIMEOUT_MS=120000

# Production on Render: deploy uploaded projects through Render's API.
# Do NOT set DOCKER_HOST on the Render web service.
DEPLOYMENT_PROVIDER=render
RENDER_API_KEY=
RENDER_OWNER_ID=tea-xxxxxxxxxxxxxxxxxxxx
RENDER_PROJECT_REGION=oregon
RENDER_PROJECT_PLAN=free
DEPLOY_GITHUB_REPO=https://github.com/YOUR_GITHUB_USER/YOUR_HOSTING_REPO
DEPLOY_GITHUB_BRANCH=main
GITHUB_TOKEN=
